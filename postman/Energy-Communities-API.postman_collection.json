		{
			"name": "Registrations",
			"item": [
				{
					"name": "Register Meter Point into Waldviertel Nord (Manager)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{manager_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"meter_point_id\": {{meter_point_managers_generation_id}},\n    \"from_date\": \"2024-01-01\",\n    \"to_date\": \"2024-02-28\",\n    \"consent_date\": \"2023-12-20\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/energy-communities/{{energy_community_waldviertel_id}}/meter-points",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"energy-communities",
								"{{energy_community_waldviertel_id}}",
								"meter-points"
							]
						},
						"description": "BR-5 through BR-8. The manager's own generation metering point, registered into Waldviertel Nord. This period (2024-01-01..2024-02-28) is deliberately entirely before the meter point's existing open-ended registration in Sonnenweide (from 2026-03-01) \u2014 BR-7 blocks any overlapping period for the same metering point across communities, so try an overlapping from_date (e.g. 2026-04-01) to see the 409 instead."
					}
				},
				{
					"name": "List Waldviertel Nord's Registrations (Manager)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{manager_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/energy-communities/{{energy_community_waldviertel_id}}/meter-points?state=accepted",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"energy-communities",
								"{{energy_community_waldviertel_id}}",
								"meter-points"
							],
							"query": [
								{
									"key": "state",
									"value": "accepted"
								}
							]
						}
					}
				},
				{
					"name": "Transition House Registration \u2014 requested \u2192 message_received (Manager)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{manager_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"state\": \"message_received\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/registrations/{{registration_house_requested_id}}/transition",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"registrations",
								"{{registration_house_requested_id}}",
								"transition"
							]
						},
						"description": "BR-9. The seeded house registration starts in `requested`; this is a legal next step. Try `{\"state\": \"accepted\"}` instead to see the illegal-transition 422."
					}
				},
				{
					"name": "Delete (Remove) Sonnenweide's Registration (Manager)",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{manager_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/registrations/{{registration_managers_new_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"registrations",
								"{{registration_managers_new_id}}"
							]
						},
						"description": "BR-10: never hard-deleted. This registration is `new`, so it maps to `removed`."
					}
				}
			]
